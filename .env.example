# Copy to .env and fill in. Never commit the real .env -- it carries secrets.
#
#   cp .env.example .env && $EDITOR .env

# ---------------------------------------------------------------------------
# Upstream Sub-Store backend. The URL may embed a secret path (this
# deployment's does), which is exactly why it belongs here and not in
# docker-compose.yml.
# ---------------------------------------------------------------------------
SUBSTORE_BACKEND=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Cloudflare Tunnel token. Written automatically by `setup_tunnel.py` when it
# creates the tunnel; set it here to pin an existing one.
# ---------------------------------------------------------------------------
TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Panel / export-endpoint auth token. Leave empty and the app generates one on
# first start, storing it in data/config.json. Read it back with:
#   python3 -c "import json;print(json.load(open('data/config.json'))['auth']['token'])"
# ---------------------------------------------------------------------------
MIHOMO_TEST_TOKEN=

# ---------------------------------------------------------------------------
# Absolute path of this project ON THE HOST. The app asks the host's docker
# daemon to bind-mount ./core for the kernel's own `mihomo -t` check, and a
# container-only path does not resolve there. Only needed when the project does
# not live at /srv/mihomo-test.
# ---------------------------------------------------------------------------
MIHOMO_TEST_HOST_ROOT=/srv/mihomo-test

# Container timezone. Note that all timestamps written to SQLite are UTC
# regardless of this setting -- see the README's timestamp convention.
TZ=Asia/Shanghai
