# ---------------------------------------------------------------------------
# Runtime state and generated config. These are bind-mounted at runtime and
# carry credentials (SQLite ledger, config.json with the panel token, kernel
# secret, exports, the tunnel token).
# ---------------------------------------------------------------------------
data/
core/

# Deployment credentials. Never commit: holds TUNNEL_TOKEN and the keyed
# SUBSTORE_BACKEND URL.
.env

# ---------------------------------------------------------------------------
# Local tooling output. .local/ holds diagnostic snapshots and screenshots
# that embed the live panel token.
# ---------------------------------------------------------------------------
.local/
.pi/
.tmpcheck/

# CDN build output and its tooling cache. `dist/` is reproducible from
# `mihomo_test/web/` via `tools/build_web.py` -- committing it would create a
# second copy of the front end that silently goes stale, and `.wrangler/` is
# just wrangler's local cache (it also records the project name, which is
# deployment-specific).
# ---------------------------------------------------------------------------
dist/
.wrangler/

# Workspace / assistant metadata (project notes may quote credentials)
.workbuddy-ai/

# Other AI tooling's workspace config
.zcodeignore

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Logs and scratch
# ---------------------------------------------------------------------------
*.log
nohup.out
*.tmp
*.bak-*
*.tar.gz

# ---------------------------------------------------------------------------
# Session diagnostics that embed live credentials or subscription URLs.
# SECURITY_REVIEW.md S-04~S-07/S-10: dom snapshots carry the real publish
# token, .tmp_diag/ holds raw subscriptions and node configs, reports/ holds
# ipmap output with orig_proxy credentials. Never commit any of these.
# ---------------------------------------------------------------------------
.tmp_diag/
reports/
dom_*.html
console_*.txt
chain-alive-*.md

# ---------------------------------------------------------------------------
# Rust workspace build output (Cargo.lock IS committed; /target is not)
# ---------------------------------------------------------------------------
/target/

# ---------------------------------------------------------------------------
# Local smoke-run scratch dir: a throwaway root with its own ledger, kernel
# config and a fake Sub-Store server. Reproducible from any empty directory.
# ---------------------------------------------------------------------------
smoke-root/
